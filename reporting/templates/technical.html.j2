{# Technical report: security engineers. Full decode, CVE links, config diffs. #}
<html lang="en">
<head><meta charset="utf-8"><title>VaultScope Technical Report</title>
<style>{{ css }}</style></head>
<body>

<div class="masthead">
  <h1>IPsec VPN Technical Assessment</h1>
  <div class="meta">
    Technical report &middot; {{ generated_at }}
    {%- if capture_name %} &middot; capture: {{ capture_name }}{% endif %}
    &middot; {{ summary.session_count }} session{{ '' if summary.session_count == 1 else 's' }}
    &middot; posture {{ summary.posture_score }}/100
    &middot; {{ anomalies|length }} runtime anomal{{ 'y' if anomalies|length == 1 else 'ies' }}
  </div>
</div>

<h2>Session inventory</h2>
<table>
  <tr>
    <th>Session</th><th>Peers</th><th>IKE</th><th>Encryption</th><th>DH</th>
    <th>PFS</th><th>Traffic &middot; AI Confidence Score</th><th>Risk Score</th><th>Severity</th>
  </tr>
  {% for s in sessions %}
  <tr>
    <td><code>{{ s.session_id }}</code></td>
    <td class="small">{{ s.initiator_ip }} &rarr; {{ s.responder_ip }}</td>
    <td>{{ s.ike.version }}{% if s.ike.aggressive_mode %} <span class="sev sev-CRITICAL">AGGR</span>{% endif %}</td>
    <td>{{ s.ike.encryption }}{% if 'encryption' in s.ike.inferred_fields %} <span class="muted small">(inferred)</span>{% endif %}</td>
    <td>{{ s.ike.dh_group }}{% if 'dh_group' in s.ike.inferred_fields %} <span class="muted small">(inferred)</span>{% endif %}</td>
    <td>{{ s.ike.pfs_status }}</td>
    <td>{% if s.traffic_prediction.model_version == 'no-esp-observed' %}<span class="muted">no ESP</span>{% else %}{{ s.traffic_prediction.predicted_type }}
        <span class="muted small">{{ '%.0f'|format(s.traffic_prediction.confidence * 100) }}%</span>
        {%- if s.traffic_prediction.abstained %} <span class="muted small">(uncertain)</span>{% endif %}
        {%- if s.traffic_prediction.top_features %}<br><span class="muted small">via {{ s.traffic_prediction.top_features|map(attribute='feature')|join(', ') }}</span>{% endif %}{% endif %}</td>
    <td>{{ s.security_assessment.risk_score }}</td>
    <td class="sev sev-{{ s.security_assessment.overall_severity }}">{{ s.security_assessment.overall_severity }}</td>
  </tr>
  {% endfor %}
</table>

<h2>Threat Matrix</h2>
{% if summary.threat_matrix %}
<table>
  <tr><th>Threat</th><th>Likelihood</th><th>Impact</th></tr>
  {% for t in summary.threat_matrix %}
  <tr><td>{{ t.threat }}</td><td>{{ t.likelihood }}</td><td>{{ t.impact }}</td></tr>
  {% endfor %}
</table>
{% else %}<p class="muted">No threats identified.</p>{% endif %}

<h2>Metadata exposure</h2>
<p class="small muted">What a passive observer learns without breaking the encryption: traffic type
from packet sizes and timing, peer identities, gateway implementation, endpoints and activity.
Scored 0 (nothing beyond the unavoidable) to 100, reported beside the Risk Score rather than in it.
Fleet mean {{ summary.metadata_exposure.mean_score }}/100.</p>
<table>
  <tr><th>Session</th><th>Exposure</th><th>What leaks</th></tr>
  {% for s in sessions %}
  {% set e = s.security_assessment.metadata_exposure %}
  <tr>
    <td><code>{{ s.session_id }}</code></td>
    <td>{{ e.score }} <span class="muted small">{{ e.level }}</span></td>
    <td class="small">{% for sig in e.signals %}<strong>{{ sig.level }}</strong> {{ sig.detail }}{% if not loop.last %}<br>{% endif %}{% else %}<span class="muted">nothing beyond the tunnel itself</span>{% endfor %}</td>
  </tr>
  {% endfor %}
</table>

<h2>Configuration compliance</h2>
{% if summary.compliance %}
<table>
  <tr><th>Baseline</th><th>Pass</th><th>Fail</th><th>Not assessed</th><th>Most common violations</th></tr>
  {% for c in summary.compliance %}
  <tr>
    <td>{{ c.name }}</td><td>{{ c.pass }}</td><td>{{ c.fail }}</td><td>{{ c.not_assessed }}</td>
    <td class="small">{{ c.violations|join(', ') or '&mdash;'|safe }}</td>
  </tr>
  {% endfor %}
</table>
<p class="small muted">Mapping of rules to each baseline is VaultScope's reading of the published
algorithm guidance, not a certification; rows marked indicative map general guidance. A requirement
whose field the capture never revealed is counted as not assessed, never as a failure.</p>
{% else %}<p class="muted">No sessions to assess.</p>{% endif %}

<h2>Key exchange method &amp; post-quantum readiness</h2>
<p class="small">
{% for status, n in summary.pqc_readiness.items() %}{{ n }} {{ status }}{% if not loop.last %} &middot; {% endif %}{% else %}<span class="muted">no sessions</span>{% endfor %}
&mdash; <span class="muted">hybrid = an RFC 9370 additional key exchange or ML-KEM group was negotiated;
classical = recorded traffic is exposed to future quantum decryption (rule R20).</span></p>

<h2>Runtime anomalies</h2>
{% if anomalies %}
<p class="small muted">Behaviour across sessions that suggests an attacker at work, as opposed
to a weak configuration. Evidence frames are 1-based frame numbers in the capture &mdash;
open it in Wireshark and go to the frame to verify.</p>
<table>
  <tr><th>Anomaly</th><th>Severity</th><th>Session</th><th>First seen</th><th>Evidence frames</th></tr>
  {% for e in anomalies %}
  <tr>
    <td><strong>{{ e.anomaly_type }}</strong><br><span class="small muted">{{ e.description }}</span></td>
    <td class="sev sev-{{ e.severity }}">{{ e.severity }}</td>
    <td><code>{{ e.session_id }}</code></td>
    <td class="small">{{ e.timestamp or '&mdash;'|safe }}</td>
    <td class="small"><code>{{ e.evidence_pkts|join(', ') if e.evidence_pkts else '&mdash;'|safe }}</code></td>
  </tr>
  {% endfor %}
</table>
{% else %}<p class="muted">No runtime anomalies detected across the sessions in this capture.</p>{% endif %}

<div class="page-break"></div>
<h2>Findings and remediation</h2>
{% for session in sessions %}
  {% if session.security_assessment.findings %}
  <h3><code>{{ session.session_id }}</code>
      <span class="muted small">{{ session.initiator_ip }} &rarr; {{ session.responder_ip }}
      &middot; vendor: {{ session.ike.vendor }}</span></h3>
    {% for f in session.security_assessment.findings %}
    <div class="finding">
      <div class="finding-head">
        <strong>{{ f.rule_id }} &mdash; {{ f.description }}</strong>
        {% if f.inferred_from %}<span class="muted small">based on inferred {{ f.inferred_from|join(', ') }}</span>{% endif %}
        <span class="sev sev-{{ f.severity }}">{{ f.severity }}</span>
      </div>
      <div class="small muted">
        {% set surl = standard_url(f.standard) %}
        {% if surl %}<a href="{{ surl }}">{{ f.standard }}</a>{% else %}{{ f.standard }}{% endif %}
        {%- if f.cve %} &middot; <a href="{{ cve_url(f.cve) }}">{{ f.cve }}</a>{% endif %}
      </div>
      <pre>{{ f.remediation }}</pre>
    </div>
    {% endfor %}
  {% endif %}
{% endfor %}

<h2>Security Association characteristics (full IKE decode)</h2>
{% for s in sessions %}
<h3><code>{{ s.session_id }}</code>
  <span class="muted small">{{ s.timestamp or 'time unknown' }}
  {%- if s.packet_refs %} &middot; IKE frames {{ s.packet_refs[:12]|join(', ') }}{% if s.packet_refs|length > 12 %}&hellip;{% endif %}{% endif %}</span></h3>
<table>
  <tr><th>Parameter</th><th>Value</th><th>Parameter</th><th>Value</th></tr>
  {% set items = s.ike.model_dump().items() | list %}
  {% for i in range(0, items|length, 2) %}
  <tr>
    <td class="muted">{{ items[i][0] }}</td><td><code>{{ items[i][1] }}</code></td>
    {% if i + 1 < items|length %}
    <td class="muted">{{ items[i+1][0] }}</td><td><code>{{ items[i+1][1] }}</code></td>
    {% else %}<td></td><td></td>{% endif %}
  </tr>
  {% endfor %}
</table>
{% endfor %}

<h2>Classifier performance</h2>
{% if confusion_matrix %}
<table>
  <tr><th>Actual \ Predicted</th>{% for label in confusion_matrix.labels %}<th>{{ label }}</th>{% endfor %}</tr>
  {% for row_label in confusion_matrix.labels %}
  <tr>
    <td class="muted">{{ row_label }}</td>
    {% for value in confusion_matrix.matrix[loop.index0] %}<td>{{ value }}</td>{% endfor %}
  </tr>
  {% endfor %}
</table>
<p class="small muted">Model {{ confusion_matrix.model_version | default('unspecified') }}
  {%- if confusion_matrix.accuracy %} &middot; overall accuracy
  {{ '%.1f'|format(confusion_matrix.accuracy * 100) }}%{% endif %}</p>
{% if heldout %}
<h3>Held-out evaluation</h3>
<p class="small muted">The figure above is one random split. Below, whole groups of captures are
held out (every capture of one cipher, DH group, mode, IP version, or configuration), the model is
trained on the rest and scored on what it never saw. "Without volume" drops packet count, rate and
duration, which the fixed-rate generators make an easy shortcut.</p>
<table>
  <tr><th>Scheme</th><th>Macro-F1</th><th>Without volume</th></tr>
  {% for scheme, r in heldout.traffic_type.all_features.items() %}
  <tr><td>{{ scheme.replace('_', ' ') }}</td><td>{{ r.pooled.f1_macro }}</td>
      <td>{{ heldout.traffic_type.without_volume_features[scheme].pooled.f1_macro }}</td></tr>
  {% endfor %}
</table>
{% endif %}
{% if summary.abstained_count %}<p class="small muted">{{ summary.abstained_count }} prediction{{ '' if summary.abstained_count == 1 else 's' }}
fell below the confidence threshold and {{ 'is' if summary.abstained_count == 1 else 'are' }} marked uncertain.</p>{% endif %}
{% else %}
<p class="muted">No trained classifier metrics available &mdash;
the Stage 4b model has not been trained yet,
so <code>models/confusion_matrix.json</code> does not exist. Traffic-type
predictions in this report carry the untrained default confidence.</p>
{% endif %}

<div class="disclosure">
  <strong>Honest reporting of ML limits.</strong> Protocol and crypto
  identification is deterministic &mdash; IKE declares these parameters in
  cleartext, so those fields are parsed, not predicted. Only where a truncated
  handshake hides a field does the Stage 4a structural classifier fill it, and
  such values are marked <em>(inferred)</em> above; a field neither parsed nor
  confidently inferred is reported as <code>unknown</code> and never scored. Stage 4b (traffic type
  inside ESP) is side-channel inference over packet-size, timing, direction and
  burst metadata; accuracy is not 100% and is reported above as a confusion
  matrix rather than a single headline number. The training data is lab-clean
  with no competing cross-traffic, so accuracy on real, noisy networks will be
  lower. The "Chat" class is approximated with a bursty chat-sized generator
  rather than real messenger traffic, which cannot be run in an isolated lab.
</div>

</body>
</html>
