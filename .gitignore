# --- VaultScope generated artifacts ---
# Captures are large and regenerable by scripts/generate_dataset.py, so they
# stay out of git. The label JSONs are the ground truth, they are small, and a
# change to one should show up in a diff -- so they are tracked. See
# data/README.md.
data/pcaps/*.pcap
data/pcaps/*.pcapng
models/*.pkl
models/*.joblib
models/*.pt
models/*.onnx
models/*.png
models/eval_metrics.json
models/confusion_matrix.json

# generated reports
reporting/out/
*.pdf
!docs/**/*.pdf

# runtime db
*.sqlite
*.sqlite3
*.db

# local env overrides
.env
.env.local

# Cypress run artifacts
tests/e2e/screenshots/
tests/e2e/videos/
