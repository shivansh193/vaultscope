# --- VaultScope generated artifacts ---
# Large capture data and trained models are regenerated by the testbed /
# training pipeline; keep them out of git. Track the ground-truth label
# JSON schema and mock fixtures instead.
data/pcaps/*.pcap
data/pcaps/*.pcapng
data/labels/*.json
models/*.pkl
models/*.joblib
models/*.pt
models/*.onnx
models/*.png
models/eval_metrics.json
models/confusion_matrix.json

# generated reports
reporting/out/
*.pdf
!docs/**/*.pdf

# runtime db
*.sqlite
*.sqlite3
*.db

# local env overrides
.env
.env.local
